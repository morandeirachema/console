# Ghostty — symlinked to ~/.config/ghostty/config by install.sh.
# GPU-accelerated, platform-native, deliberately minimal: tmux handles tabs/splits/sessions.
# Docs: https://ghostty.org/docs  ·  reference: https://ghostty.org/docs/config/reference
# Validate: ghostty +validate-config   ·  Reload: Cmd/Ctrl+Shift+,

# --- font: JetBrainsMono Nerd Font — the same font install.sh installs, so prompt/tmux/nvim
#     glyphs render with no manual "set your terminal font" step (bold/italic auto-selected).
font-family = JetBrainsMono Nerd Font
font-size = 12

# --- window ---
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
background-opacity = 0.98
scrollback-limit = 52428800
confirm-close-surface = false

# --- cursor ---
cursor-style = block
cursor-style-blink = false

# --- shell integration ---
# Ghostty sets TERM=xterm-ghostty. Servers rarely have that terminfo, so `ssh-terminfo`
# copies it over on first connect and `ssh-env` falls back to xterm-256color when it can't —
# otherwise `clear`/tmux/less break on every box this repo targets.
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ── Catppuccin Mocha ── explicit palette (not `theme =`) so it stays byte-identical
#    to alacritty.toml / kitty.conf, the starship prompt, tmux, and LazyVim.
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
selection-background = #f5e0dc
selection-foreground = #1e1e2e

# black / bright-black
palette = 0=#45475a
palette = 8=#585b70
# red
palette = 1=#f38ba8
palette = 9=#f38ba8
# green
palette = 2=#a6e3a1
palette = 10=#a6e3a1
# yellow
palette = 3=#f9e2af
palette = 11=#f9e2af
# blue
palette = 4=#89b4fa
palette = 12=#89b4fa
# magenta
palette = 5=#f5c2e7
palette = 13=#f5c2e7
# cyan
palette = 6=#94e2d5
palette = 14=#94e2d5
# white / bright-white
palette = 7=#bac2de
palette = 15=#a6adc8
